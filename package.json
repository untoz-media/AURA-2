{
  "name": "aura-2",
  "version": "0.9.0-beta.1",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace @untoz/aura-desktop run tauri:dev",
    "build": "npm --workspace @untoz/aura-desktop run tauri:build",
    "frontend:dev": "npm --workspace @untoz/aura-desktop run dev",
    "frontend:build": "npm --workspace @untoz/aura-desktop run build",
    "icons": "npm --workspace @untoz/aura-desktop run icons",
    "release:check": "node scripts/check-release.mjs",
    "beta:source-check": "node scripts/check-beta-source.mjs",
    "beta:quality": "npm run release:check && npm run telemetry:check && npm run beta:source-check && npm run frontend:build",
    "telemetry:check": "node scripts/check-telemetry-policy.mjs",
    "beta:release-check": "node scripts/check-beta-release.mjs",
    "beta:release-gate": "npm run beta:quality && npm run beta:release-check"
  }
}
