{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURA-2",
  "version": "0.8.0-alpha.1",
  "identifier": "site.untoz.aura2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AURA-2",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "AURA",
        "url": "index.html?view=overlay",
        "width": 720,
        "height": 150,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Untoz",
    "category": "Productivity",
    "copyright": "© 2026 Untoz. All rights reserved.",
    "shortDescription": "A local-first personal AI assistant for Windows.",
    "longDescription": "AURA-2 is a local-first personal AI assistant for Windows with computer control, Voice, Vision, Agents, Automations and OBS Director Mode.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "Untoz",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
