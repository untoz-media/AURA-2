{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURA-2",
  "version": "0.2.0",
  "identifier": "site.untoz.aura2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AURA-2",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "AURA",
        "url": "index.html?view=overlay",
        "width": 720,
        "height": 150,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
